# Copy to .env.local for local development. Never commit real values.

# ── Database (added automatically when you connect Neon in Vercel → Storage) ──
# Without it, local development stores CMS data in .cms-data/ (git-ignored).
DATABASE_URL=

# ── Image uploads (added automatically when you connect Blob in Vercel → Storage) ──
# Without it, local development saves uploads to public/uploads/ (git-ignored).
BLOB_READ_WRITE_TOKEN=

# ── Admin ──
# One-time code needed to create the owner account at /admin/setup (required in production).
ADMIN_SETUP_CODE=
# Signs admin login cookies. Optional — derived from DATABASE_URL if empty.
ADMIN_SESSION_SECRET=

# ── Email alerts (Resend) ──
RESEND_API_KEY=
# Fallback recipients if none are set in Admin → Settings (comma-separated).
ORDER_NOTIFICATION_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# ── Optional: live Google reviews ──
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
